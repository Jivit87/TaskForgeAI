# ─── FRAME-MO Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your keys. Never commit .env to git.

# Master Orchestrator — Ollama Local
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_ORCHESTRATOR_MODEL=kimi-k2.5:cloud 

# Sub-Agents — Groq LLaMA 3.3
GROQ_API_KEY=gsk_your_key_here

# MCP — GitHub (Code Sub-Agent)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here

# MCP — Tavily Search (Research Sub-Agent)
TAVILY_API_KEY=tvly-your_key_here

# MCP — Notion (Knowledge Sub-Agent)
NOTION_TOKEN=secret_...

# Optional: Override SQLite checkpoint path
